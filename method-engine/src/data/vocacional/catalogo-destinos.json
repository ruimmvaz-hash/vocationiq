{
  "meta": {
    "nome": "Catálogo Vocacional Naveya — dicionário de destinos",
    "versao": "2.0 — internacional",
    "fonte": "CATALOGO-VOCACIONAL.md v1.1",
    "arquitectura": {
      "principio": "O destino é universal; o NOME é local. O id e o código ISCED nunca mudam de país — só o label muda.",
      "camada_1_destino": "id + isced_area + isced_nivel. Universal. É por aqui que os índices (planetas, combinações, nakshatras, índice inverso) referenciam.",
      "camada_2_localizacao": "labels por país. PT está tabelado; os outros são produzidos pelo agente a partir da âncora ISCED.",
      "camada_3_sistema_educativo": "ficheiro separado por país (vias, níveis, portas concretas). Módulo que se liga ou desliga."
    },
    "isced": {
      "o_que_e": "Classificação Internacional Tipo da Educação (ISCED-F 2013, UNESCO). A CNAEF portuguesa deriva dela — os códigos são os mesmos em Portugal, Brasil, Espanha, Angola ou Alemanha.",
      "isced_area": "código de 4 dígitos da ÁREA de formação. Não indica nível: 0713 cobre tanto Engenharia Electrotécnica como Técnico de Electricidade.",
      "isced_nivel": "níveis em que essa formação existe. 3=secundário · 4=pós-secundário não superior · 5=superior de ciclo curto · 6=licenciatura · 7=mestrado · null=fora do sistema formal"
    },
    "vias_por_nivel": {
      "nota": "As quatro Vias do catálogo (1.3) são universais — descrevem tipo de percurso, não sistema português.",
      "A": {
        "niveis": [
          6,
          7
        ],
        "pt": "Licenciatura + Mestrado"
      },
      "B": {
        "niveis": [
          3,
          4
        ],
        "pt": "Cursos Profissionais, CEF, Aprendizagem IEFP"
      },
      "C": {
        "niveis": [
          5
        ],
        "pt": "CTeSP",
        "outros_nomes": "community college, associate degree, tecnólogo, BTS, HND"
      },
      "D": {
        "niveis": null,
        "pt": "fora do sistema formal"
      }
    },
    "camadas": {
      "superior": "Ensino superior formal. Âncora ISCED forte — o agente localiza com segurança.",
      "tecnico": "Vias técnicas e profissionais. Âncora ISCED de área; o nome varia muito por país.",
      "fora": "Caminhos fora do sistema formal. Sem código — são universais por natureza. Exigem sempre via de sustento associada (regra 7.4)."
    },
    "regra_nomenclatura": {
      "geral": "O nome que aparece no relatório é o de um CURSO ou caminho concreto — nunca uma função, um cargo ou uma área genérica. 'Gestão de Empresas' é válido; 'Gestão' não é; 'Direcção de projecto editorial' não é.",
      "pt": "Usar labels.PT. Verificado contra DGES.",
      "outros_paises": "O agente nomeia a formação como ela se chama no país do cliente, a partir de isced_area + isced_nivel + labels.PT como referência de sentido.",
      "regra_de_seguranca": "Se o agente não souber com confiança como se chama a formação nesse país, escreve a DESCRIÇÃO em vez de inventar um nome. 'Formação superior em enfermagem, com prática clínica supervisionada' é preferível a um nome inventado.",
      "instituicoes": "NUNCA nomear instituições de ensino — nem em Portugal. Mudam de oferta, encerram cursos e alteram designações. O relatório nomeia a formação, não a escola."
    }
  },
