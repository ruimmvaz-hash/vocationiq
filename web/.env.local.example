# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (mesma conta Stripe da Naveya — produto/preço novos, ver README)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional — se definido, o checkout usa este Price ID em vez de criar o preço em runtime.
STRIPE_PRICE_ID=
# Idem, para o produto VocationIQ Revisão (€49) — scripts/create-stripe-revisao-product.ts.
STRIPE_REVISAO_PRICE_ID=

# Revolut Business (avaliação em curso, Set 2026 — ver app/api/checkout/route.ts).
# PAYMENT_PROVIDER="revolut" liga o checkout à Revolut em vez da Stripe;
# qualquer outro valor (ou a variável em falta) mantém a Stripe. Nunca
# pôr "revolut" em produção sem antes testar o fluxo completo em sandbox.
PAYMENT_PROVIDER=
# REVOLUT_ENV="production" usa https://merchant.revolut.com/api; qualquer
# outro valor (ou em falta) usa o sandbox — default deliberadamente seguro.
REVOLUT_ENV=
REVOLUT_API_KEY=
REVOLUT_WEBHOOK_SIGNING_SECRET=

# Supabase (mesmo projecto da Naveya)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email transaccional)
RESEND_API_KEY=

# Painel /admin — password simples, pode ser diferente da da Naveya.
ADMIN_PASSWORD=

# Sistema de comerciais — secret próprio para assinar os tokens de magic
# link/sessão (qualquer string longa e aleatória, ex.: openssl rand -hex 32).
COMERCIAL_TOKEN_SECRET=

# Microsoft Clarity — id do projecto (pode ser o mesmo da Naveya ou um novo, dashboard.clarity.microsoft.com).
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# /admin/trafego — métricas básicas via Vercel Web Analytics. Opcional: sem
# isto a página só mostra o link da Clarity. VERCEL_API_TOKEN gera-se em
# vercel.com/account/tokens; VERCEL_PROJECT_ID está em Project Settings;
# VERCEL_TEAM_ID só é preciso se o projecto pertencer a uma equipa.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Cron diário de emails de revisão (/api/cron/revisao-emails) — o Vercel
# envia automaticamente "Authorization: Bearer $CRON_SECRET" quando esta
# env var está definida no projecto, sem configuração extra.
CRON_SECRET=
